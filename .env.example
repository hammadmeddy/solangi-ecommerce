# SQLite local (default). For Hostinger MySQL later:
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/solangi"
DATABASE_URL="file:./dev.db"

# Sign session cookies — use a long random value in production
SOLANGI_AUTH_SECRET="change-me-to-a-long-random-secret"

# Gmail (or other SMTP) for email OTP — use a Google App Password, not your normal password
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="your-gmail@gmail.com"
SMTP_PASS="xxxx xxxx xxxx xxxx"
SMTP_FROM="Solangi Ecommerce <your-gmail@gmail.com>"

# Set to 1 only for demos that must keep OTP 123456
# SOLANGI_FORCE_DEMO_OTP="1"
