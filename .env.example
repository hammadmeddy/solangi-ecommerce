# SQLite local (default). For Hostinger MySQL later:
# DATABASE_URL="mysql://USER:PASSWORD@HOST:3306/solangi"
DATABASE_URL="file:./dev.db"

# Sign session cookies — use a long random value in production
SOLANGI_AUTH_SECRET="change-me-to-a-long-random-secret"

# Hostinger mailbox SMTP for email OTP
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER="orders@solangiecommerce.com"
SMTP_PASS="the-mailbox-password"
SMTP_FROM="Solangi Ecommerce <orders@solangiecommerce.com>"

# Set to 1 only for demos that must keep OTP 123456
# SOLANGI_FORCE_DEMO_OTP="1"

# Public site address used in links inside seller emails (default https://solangiecommerce.com)
# SOLANGI_SITE_URL="https://solangiecommerce.com"

# Extra phones allowed to sign in as admin, comma-separated (optional)
# SOLANGI_ADMIN_PHONES="03000000000"
