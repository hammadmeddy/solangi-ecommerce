// Solangi backend — MySQL (Hostinger).
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  phone     String   @unique
  name      String
  email     String?
  /// customer | seller | admin
  role      String   @default("customer")
  /// active | suspended
  status    String   @default("active")
  city      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  otps      OtpChallenge[]
  orders    Order[]
  listings  Product[]      @relation("SellerProducts")
  store     SellerStore?
  cartItems CartItem[]
  reviews   Review[]
  addresses Address[]
  wishlist  WishlistItem[]
  sales     OrderItem[]    @relation("SellerSales")
  payouts   Payout[]
}

model OtpChallenge {
  id        String   @id @default(cuid())
  phone     String
  email     String?
  code      String
  name      String?
  role      String   @default("customer")
  purpose   String   @default("login")
  expiresAt DateTime
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  @@index([phone, consumed])
}

model Category {
  id         String    @id
  name       String
  photoLabel String
  hrefKind   String    @default("category")
  sortOrder  Int       @default(0)
  imageUrl   String?
  products   Product[]
}

model Product {
  id            String   @id
  name          String
  categoryId    String
  category      Category @relation(fields: [categoryId], references: [id])
  pricePkr      Int
  oldPricePkr   Int?
  discountLabel String?
  rating        Int      @default(4)
  description   String
  sellerName    String
  stockLabel    String   @default("In stock")
  stock         Int      @default(20)
  /// retail | wholesale | used | services
  mode          String   @default("retail")
  minQty        Int?
  condition     String?
  serviceArea   String?
  imageUrl      String?
  /// pending | active | rejected | draft | out
  status        String   @default("active")
  reviewNote    String?
  sellerId      String?
  seller        User?    @relation("SellerProducts", fields: [sellerId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orderItems    OrderItem[]
  cartItems     CartItem[]
  reviews       Review[]

  @@index([mode, categoryId])
  @@index([status])
}

model SellerStore {
  id       String  @id @default(cuid())
  userId   String  @unique
  user     User    @relation(fields: [userId], references: [id])
  name     String
  slug     String  @unique
  city     String
  phone    String
  bio      String  @default("")
  verified Boolean @default(false)
  /// pending | approved | rejected | suspended
  status          String    @default("pending")
  cnic            String?
  /// Overrides SiteSetting.defaultCommissionPct when set
  commissionPct   Int?
  rejectionReason String?
  appliedAt       DateTime  @default(now())
  reviewedAt      DateTime?

  @@index([status])
}

model Order {
  id           String   @id @default(cuid())
  publicId     String   @unique
  userId       String?
  user         User?    @relation(fields: [userId], references: [id])
  /// placed | packed | shipped | delivered | cancelled
  status       String   @default("placed")
  totalPkr     Int
  itemCount    Int
  summary      String
  payment      String   @default("COD")
  addressLabel String
  customerName String?
  phone        String?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  items        OrderItem[]
}

model OrderItem {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  productId String?
  product   Product? @relation(fields: [productId], references: [id])
  name      String
  qty       Int
  pricePkr  Int
  sellerId      String?
  seller        User?    @relation("SellerSales", fields: [sellerId], references: [id])
  commissionPkr Int      @default(0)
  /// placed | packed | shipped | delivered | cancelled
  itemStatus    String   @default("placed")

  @@index([sellerId, itemStatus])
}

model Payout {
  id          String    @id @default(cuid())
  sellerId    String
  seller      User      @relation(fields: [sellerId], references: [id])
  amountPkr   Int
  periodLabel String    @default("")
  /// pending | paid
  status      String    @default("pending")
  note        String    @default("")
  paidAt      DateTime?
  createdAt   DateTime  @default(now())

  @@index([sellerId, status])
}

model SiteSetting {
  id           String  @id @default("solo")
  announcement String  @default("")
  heroRetail   String?
  heroFlash    String?
  heroModes    String?
  defaultCommissionPct Int @default(10)
}

model Address {
  id        String  @id @default(cuid())
  userId    String
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label     String
  fullName  String
  phone     String
  line1     String
  line2     String  @default("")
  city      String
  province  String  @default("")
  isDefault Boolean @default(false)

  @@index([userId])
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId String
  name      String
  category  String   @default("")
  pricePkr  Int
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model CartItem {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  productId  String
  product    Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  name       String
  category   String
  categoryId String
  pricePkr   Int
  qty        Int      @default(1)
  updatedAt  DateTime @updatedAt
  createdAt  DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
}

model Review {
  id         String   @id @default(cuid())
  quote      String
  author     String
  meta       String   @default("")
  rating     Int      @default(5)
  /// pending | approved | rejected
  status     String   @default("approved")
  locale     String   @default("en")
  sortOrder  Int      @default(0)
  productId  String?
  product    Product? @relation(fields: [productId], references: [id], onDelete: SetNull)
  userId     String?
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([status, sortOrder])
}
